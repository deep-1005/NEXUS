# ----- Helper: get numpy image for an ee.Image clipped to AOI and resized -----
def ee_image_to_numpy(img, aoi_geom, width=512, height=512):
    # Extract polygon coordinates as client-side list
    coords = aoi_geom.coordinates().getInfo()  # <-- THIS fixes ALL geometry errors

    region_json = {
        "type": "Polygon",
        "coordinates": coords  # coords is already a list of rings
    }

    # Generate thumbnail URL
    url = img.getThumbURL({
        'region': region_json,
        'format': 'png',
        'dimensions': f'{width}x{height}'
    })

    import requests
    from io import BytesIO
    response = requests.get(url)

    # safety check
    if response.status_code != 200:
        raise Exception("Could not fetch from backend: " + response.text)

    pil_img = Image.open(BytesIO(response.content)).convert("RGB")
    return np.array(pil_img)


