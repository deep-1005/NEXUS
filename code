def sentinel_year_composite(aoi_geom, year):
    start = f'{year}-01-01'
    end   = f'{year}-12-31'

    col = (
        ee.ImageCollection('COPERNICUS/S2_SR')
        .filterDate(start, end)
        .filterBounds(aoi_geom)
        .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 60))
        .map(maskS2)                                  # mask clouds
        .map(lambda img: img.select(['B4','B3','B2']))  # <<< IMPORTANT FIX
    )

    comp = col.median()                               # now safe — all images have same 3 bands

    comp_8bit = comp.divide(3000).multiply(255).uint8()
    return comp_8bit

