# ----- Main pipeline: take place name + years, produce masks & change map -----
def process_place(place_name, year1, year2, tile_size=512):
    bbox, center = bbox_from_place(place_name, padding_km=25.0)

    minx, miny, maxx, maxy = bbox
    aoi = ee.Geometry.Rectangle([minx, miny, maxx, maxy], geodesic=False)

    print("AOI bbox:", bbox, "center:", center)

    # get composites
    img1 = sentinel_year_composite(aoi, year1)
    img2 = sentinel_year_composite(aoi, year2)

    # Resize or tile depending on bbox size; for demo, we'll resize entire bbox to tile_size
    np_img1 = ee_image_to_numpy(img1, aoi, width=tile_size, height=tile_size)
    np_img2 = ee_image_to_numpy(img2, aoi, width=tile_size, height=tile_size)
  

    # Convert to PIL Images
    pil1 = Image.fromarray(np_img1.astype(np.uint8))
    pil2 = Image.fromarray(np_img2.astype(np.uint8))

    # Run processor+model exactly like in your original snippet
    inputs1 = processor(images=pil1, return_tensors="pt")
    inputs2 = processor(images=pil2, return_tensors="pt")
    with torch.no_grad():
        out1 = model(**inputs1)
        out2 = model(**inputs2)
    mask1 = torch.nn.functional.interpolate(out1.logits, size=pil1.size[::-1], mode="bilinear", align_corners=False).argmax(dim=1)[0].cpu().numpy()
    mask2 = torch.nn.functional.interpolate(out2.logits, size=pil2.size[::-1], mode="bilinear", align_corners=False).argmax(dim=1)[0].cpu().numpy()

    # change map and class transitions
    change_map = (mask1 != mask2).astype(np.uint8)
    id2label = model.config.id2label
    # count transitions
    from collections import Counter
    transitions = Counter()
    flat1 = mask1.flatten()
    flat2 = mask2.flatten()
    for a,b in zip(flat1, flat2):
        if a!=b:
            transitions[f"{id2label.get(int(a),'?')} → {id2label.get(int(b),'?')}"] += 1

    return pil1, pil2, mask1, mask2, change_map, transitions

