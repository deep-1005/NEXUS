# ----- Helper: make a year composite from Sentinel-2 -----
def maskS2(image):
    # Use SCL: 4 = cloud shadow, 5 = cloud, 6 = high cloud, 7 = cirrus
    scl = image.select('SCL')
    cloud_mask = scl.neq(4).And(scl.neq(5)).And(scl.neq(6)).And(scl.neq(7))
    return image.updateMask(cloud_mask)

