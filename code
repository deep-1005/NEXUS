# ----- Helper: geocode place -> bbox -----
def bbox_from_place(place_name, padding_km=2.0):
    geolocator = Nominatim(user_agent="gee_seg_app")
    loc = geolocator.geocode(place_name)
    if loc is None:
        raise ValueError(f"Could not geocode '{place_name}'")
    lat, lon = loc.latitude, loc.longitude
    # small square around point (approx): convert km -> degrees (approx)
    deg_per_km = 1/111.32
    pad_deg = padding_km * deg_per_km
    minx, miny = lon - pad_deg, lat - pad_deg
    maxx, maxy = lon + pad_deg, lat + pad_deg
    return (minx, miny, maxx, maxy), (lat, lon)

